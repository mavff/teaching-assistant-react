config:
  theme: base
  layout: dagre
  themeVariables:
    fontFamily: Arial
    fontSize: 22px
    primaryColor: '#f6faf7'
    primaryTextColor: '#182b35'
    primaryBorderColor: '#182b35'
    lineColor: '#182b35'
    secondaryColor: '#e4f8fa'
  class:
    theme: base
    look: classic
    nodeSpacing: 90
