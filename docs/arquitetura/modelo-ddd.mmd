%% CLIENTE: módulos já validados.
namespace Cliente {
  class Application
  class Students
  class Goals
  class StudentService["Student Service"]
  class Email
  class ConfiguracaoLembretesCliente["Configuração de lembretes"]
  class HistoricoNotificacoesCliente["Histórico de notificações"]
  class EmailService["Email Service"]
}

class Interface["Interface (i)"]

%% SERVIDOR: base do professor e extensões validadas.
namespace Servidor {
  class Services {
    addStudent()
    removeStudent()
    synchronize()
    configurarLembretes()
    consultarHistorico()
    consultarDetalhesNotificacao()
  }
  class StudentListImport["StudentList Import"]
  class StudentList {
    add(Student)
    remove(Student)
  }
  class Student {
    name
    email
  }
  class GradesImportService["Grades Import Service"]
  class Classes
  class Class {
    semester
  }
  class Enrolment
  class Evaluation {
    goal
    grade
  }
  class GradeNotification["Grade Notification"]
  class EmailSender {
    send(String[])
  }
  class ConfiguracaoLembretes {
    add(Lembrete)
    remove(Lembrete)
    atualizar(quantidade, lembretesPropostos, instanteAtual, prazoAcademico)
  }
  class Lembrete {
    id
    data
    horário
    estado
    reagendar(novaData, novoHorario, instanteAtual, prazoAcademico)
    jaFoiEnviado() boolean
    marcarComoEnviado()
  }
  class LembreteService["Lembrete Service"] {
    processar(Lembrete)
  }
  class HistoricoNotificacoes {
    registrar(Notificacao)
  }
  class Notificacao {
    dataHora
    resultado
    motivo
    descricaoFalha
  }
}

