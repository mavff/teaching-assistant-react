%% CLIENTE: módulos já validados.
namespace Cliente {
  class Application
  class Students
  class Goals
  class StudentService["Student Service"]
  class Email
  class ConfiguracaoLembretesCliente["Configuração de lembretes"]
  class HistoricoNotificacoesCliente["Histórico de notificações"]
  class EmailService["Email Service"]
}

class Interface["Interface (i)"]

%% SERVIDOR: base do professor e extensões validadas.
namespace Servidor {
  class Services {
    addStudent()
    removeStudent()
    synchronize()
    configurarLembretes(turma, quantidade, lembretesPropostos) String
    consultarConfiguracaoLembretes(turma)
    consultarHistorico()
    filtrarHistorico(disciplina, turma)
    consultarDetalhesNotificacao(idNotificacao)
  }
  class StudentListImport["StudentList Import"]
  class StudentList {
    add(Student)
    remove(Student)
  }
  class Student {
    name
    email
  }
  class GradesImportService["Grades Import Service"]
  class Classes {
    buscar(turma) Class
  }
  class Class {
    semester
    prazoAcademico
    prazoEncerrado(instanteAtual) boolean
    obterConfiguracaoLembretes() ConfiguracaoLembretes
    identificarPendencias(instanteAtual)
  }
  class Enrolment {
    buscarNota(avaliacao)
    listarAvaliacoes() Evaluation[]
  }
  class Evaluation {
    goal
    grade
    dataAvaliacao
  }
  class GradeNotification["Grade Notification"]
  class EmailSender {
    send(String[])
    send(destinatario, assunto, conteudo)
  }
  class ConfiguracaoLembretes {
    add(Lembrete)
    remove(Lembrete)
    atualizar(quantidade, lembretesPropostos, instanteAtual, prazoAcademico)
    buscarLembretesPara(data, horario) Lembrete[]
    listar() Lembrete[]
  }
  class Lembrete {
    id
    data
    horário
    estado
    motivo
    reagendar(novaData, novoHorario, instanteAtual, prazoAcademico)
    jaFoiEnviado() boolean
    marcarComoEnviado()
    ignorar(motivo)
  }
  class NotificacaoService["NotificaçãoService"] {
    emailProfessor
    processar(Lembrete)
    processarAgendados(turma, data, horario)
  }
  class HistoricoNotificacoes {
    registrar(Notificacao)
    listar() Notificacao[]
    filtrar(disciplina, turma) Notificacao[]
    buscar(idNotificacao)
  }
  class Notificacao {
    id
    nomeDestinatario
    turmaRegistrada
    dataHora
    resultado
    motivo
    descricaoFalha
    pendenciasRegistradas
    prazoRegistrado
  }
  note for Notificacao "resultado:<br/>Enviado/Falha: tentativa de envio.<br/>Ignorado: processamento sem envio."
}

