# O envio SMTP requer Node.js 20 ou superior.
# Copie este modelo para server/.env e preencha somente nesse arquivo local.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_SMTP_TEST_TO=

# Notificações de grupos e monitores: use smtp para enviar de verdade pelo Gmail acima.
# Sem esta linha, o envio é simulado (nada sai pela internet).
NOTIFICACOES_GRUPO_EMAIL=
