{
  "compilerOptions": {
    "target": "es2018",
    "lib": [
      "es2018",
      "dom"
    ],
    "types": [
      "cypress",
      "node"
    ],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "module": "node16"
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts"
  ]
}
